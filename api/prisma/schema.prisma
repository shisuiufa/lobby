generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  username               String             @unique
  displayName            String             @map("display_name")
  passwordHash           String             @map("password_hash")
  emailVerifiedAt        DateTime?          @map("email_verified_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  sessions               Session[]
  emailVerification      EmailVerification?
  sentFriendRequests     FriendRequest[]    @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]    @relation("ReceivedFriendRequests")
  firstUserFriends       Friend[]           @relation("FirstUserFriends")
  secondUserFriends      Friend[]           @relation("SecondUserFriends")

  @@map("users")
}

model Session {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique @map("refresh_token_hash")
  revokedAt        DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model OutboxEvent {
  id Int @id @default(autoincrement())

  exchangeName String @map("exchange_name")
  routingKey   String @map("routing_key")
  payload      Json

  status        OutboxStatus @default(PENDING)
  retries       Int          @default(0)
  nextAttemptAt DateTime?    @map("next_attempt_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, updatedAt])
  @@map("outbox_events")
}

model EmailVerification {
  id Int @id @default(autoincrement())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("email_verifications")
}

model FriendRequest {
  id Int @id @default(autoincrement())

  senderId String @map("sender_id")
  sender   User   @relation("SentFriendRequests", fields: [senderId], references: [id])

  recipientId String @map("recipient_id")
  recipient   User   @relation("ReceivedFriendRequests", fields: [recipientId], references: [id])

  status FriendRequestStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([senderId, status, createdAt])
  @@index([recipientId, status, createdAt])
  @@map("friend_requests")
}

model Friend {
  id Int @id @default(autoincrement())

  firstUserId String @map("first_user_id")
  firstUser   User   @relation("FirstUserFriends", fields: [firstUserId], references: [id])

  secondUserId String @map("second_user_id")
  secondUser   User   @relation("SecondUserFriends", fields: [secondUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([firstUserId])
  @@index([secondUserId])
  @@map("friends")
}
